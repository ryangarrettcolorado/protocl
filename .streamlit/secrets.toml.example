# Copy this file to secrets.toml for local dev (gitignored)
# In Streamlit Cloud, paste these key=value pairs into Advanced Settings -> Secrets
#
# v3.2 adds Google SSO via Streamlit native OIDC (st.login). v3.3 adds AI
# explainers via OpenAI. Both require the keys below. NEVER commit the real
# secrets.toml — it is in .gitignore.

# ── v3.3 AI Explainers ──────────────────────────────────────────────────────
# Used by modules/llm.py and protocl/explainers/. Tier 1/2 use gpt-4o-mini,
# Tier 3 chat uses gpt-4o.
OPENAI_API_KEY = "sk-proj-replace-me"

# Optionally also configurable under an [openai] table; either form works.
[openai]
api_key = "sk-proj-replace-me"

GITHUB_TOKEN = "ghp-replace-me"

# ── v3.2 Beta Tier — Google SSO (Streamlit native OIDC) ─────────────────────
# Streamlit >= 1.42 reads st.login()/st.user/st.logout() from this [auth]
# section. Ryan creates a Google Cloud OAuth 2.0 Client ID (Web application)
# with the redirect URI below, then pastes the four Google values here.
# Generate cookie_secret with: python -c "import secrets; print(secrets.token_hex(32))"
[auth]
redirect_uri = "https://<your-streamlit-app-url>/oauth2callback"
cookie_secret = "replace-with-256-bit-hex-secret"
client_id = "<google-oauth-client-id>.apps.googleusercontent.com"
client_secret = "<google-oauth-client-secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://your-project.supabase.co"
anon_key = "replace-me"
service_role_key = "replace-me"

[app]
owner_email = "ryangarrettcolorado@gmail.com"
timezone = "America/Denver"
